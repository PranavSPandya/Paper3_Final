         <photoshop:TextLayers>
            <rdf:Bag>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>This project has received funding from the European Unionâ€™s Hor</photoshop:LayerName>
                  <photoshop:LayerText>This project has received funding from the European Unionâ€™s Horizon Europe research and innovation program under the Marie Sklodowska-Curie (G.A. n. 101073357).</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>We're seeking just 5 minutes of your time to complete our surve</photoshop:LayerName>
                  <photoshop:LayerText>We're seeking just 5 minutes of your time to complete our survey that examines how we perceive "safety" in our campus commuting environments. The survey can be filled only by computer.   Why participate? Your feedback is incredibly meaningful and important to us. Your unique perspectives as architecture students will directly contribute to our upcoming study on how sensory experiences change throughout the day and night.  </photoshop:LayerText>
               </rdf:li>
            </rdf:Bag>
         </photoshop:TextLayers>
