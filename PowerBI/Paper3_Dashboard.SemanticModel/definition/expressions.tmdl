/// Full path of merged_all_11participants_8min.csv (Home > Transform data > Edit parameters)
expression CsvPath = "C:\Users\sanga\Desktop\Pranav Paper3_Final\output\merged_all_11participants_8min.csv" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]
	lineageTag: 6ebc37a6-2de3-52e1-bf60-61168d677655

	annotation PBI_ResultType = Text

/// Keep rows with elapsed time in phase below this many minutes (8 = the 8-min protocol window)
expression MaxElapsedMin = 8 meta [IsParameterQuery=true, Type="Number", IsParameterQueryRequired=true]
	lineageTag: e3abb0e1-cf8f-57ed-bee3-9efded8cf87c

	annotation PBI_ResultType = Number

/// Staging query (not loaded): CSV rows of the 6 phases, needed columns, Slot = elapsed 10 s steps
expression Base =
		let
		    Source = Csv.Document(File.Contents(CsvPath), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
		    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
		    Kept = Table.SelectColumns(Promoted, {"ParticipantID", "PhaseID", "Datetime", "BVF", "Building_%", "SVF", "Sky_%", "TVF", "Total_Vegetation_%", "Tree_%", "atmo_lys_LYS1__lys_kelvin", "atmo_lys_LYS1__lys_lux", "atmo_lys_LYS1__lys_medi", "atmo_lys_LYS2__lys_kelvin", "atmo_lys_LYS2__lys_lux", "atmo_lys_LYS2__lys_medi", "atmo_lys_atmotube_left__atmotube_pm1", "atmo_lys_atmotube_left__atmotube_pm10", "atmo_lys_atmotube_left__atmotube_pm2.5", "atmo_lys_atmotube_right__atmotube_pm1", "atmo_lys_atmotube_right__atmotube_pm10", "atmo_lys_atmotube_right__atmotube_pm2.5", "dominant_frequency_Hz", "empatica__eda_scl_usiemens", "empatica_eda_phasic", "empatica_eda_tonic", "empatica_heart_rate", "empatica_hrv_fd_hf", "empatica_hrv_fd_hfnu", "empatica_hrv_fd_lf", "empatica_hrv_fd_lf_hf_ratio", "empatica_hrv_fd_lfnu", "empatica_hrv_fd_total_power", "empatica_hrv_fd_vlf", "empatica_hrv_td_rmssd", "empatica_hrv_td_sdnn", "empatica_skin_temperature", "empatica_vector_magnitude", "eyetracker_blink_duration_s", "eyetracker_distance_from_center", "eyetracker_eyelid_aperture_avg", "eyetracker_fixation_duration_s", "eyetracker_fixation_rate", "eyetracker_gaze_centrality", "eyetracker_gaze_dispersion", "eyetracker_gaze_velocity", "eyetracker_pupil_change_rate", "eyetracker_pupil_diameter_avg", "eyetracker_saccade_amplitude", "eyetracker_saccade_duration_s", "eyetracker_saccade_peak_velocity", "eyetracker_stress_composite", "freq_proportion_2000_to_20000Hz", "freq_proportion_200_to_2000Hz", "freq_proportion_20_to_200Hz", "gvi_50m", "gvi_grass_50m", "gvi_plant_50m", "gvi_tree_50m", "mechanisms_proportion", "octave_proportion_1000_0_Hz", "octave_proportion_125_0_Hz", "octave_proportion_2000_0_Hz", "octave_proportion_250_0_Hz", "octave_proportion_31_5_Hz", "octave_proportion_4000_0_Hz", "octave_proportion_500_0_Hz", "octave_proportion_63_0_Hz", "octave_proportion_8000_0_Hz", "questionnaire_current_comfort_1_7", "questionnaire_environmental_comfort_mean_1_5", "questionnaire_pleasantness_1_5", "questionnaire_prs11_being_away_mean_1_5", "questionnaire_prs11_coherence_mean_1_5", "questionnaire_prs11_fascination_mean_1_5", "questionnaire_prs11_scope_mean_1_5", "questionnaire_prs11_total_mean_1_5", "questionnaire_stai6_mean_1_5", "questionnaire_thermal_comfort_1_5", "rural_natural_proportion", "spectral_centroid_Hz", "spectral_rolloff85_Hz", "ucm_AIR_RH", "ucm_AIR_temp", "ucm_GPS_speed_kmh", "ucm_HUMIDEX", "ucm_MRT", "ucm_PET", "ucm_SND_dBA", "ucm_SUN_Gh", "ucm_UTCI", "ucm_WIND_AWS", "unidentify_proportion", "urban_manmade_negative_proportion", "urban_manmade_neutral_proportion", "urban_manmade_positive_proportion", "vehicle_proportion", "wind_proportion"}),
		    // reststop excluded; only the 6 dashboard phases
		    Phases = Table.SelectRows(Kept, each List.Contains({"WalkU", "BikeU", "WalkG", "BikeG", "Tram", "Indoor"}, [PhaseID])),
		    // en-US culture: '.' decimals and scientific notation parse on any Windows locale
		    Typed = Table.TransformColumnTypes(Phases, {{"Datetime", type datetime}, {"BVF", type number}, {"Building_%", type number}, {"SVF", type number}, {"Sky_%", type number}, {"TVF", type number}, {"Total_Vegetation_%", type number}, {"Tree_%", type number}, {"atmo_lys_LYS1__lys_kelvin", type number}, {"atmo_lys_LYS1__lys_lux", type number}, {"atmo_lys_LYS1__lys_medi", type number}, {"atmo_lys_LYS2__lys_kelvin", type number}, {"atmo_lys_LYS2__lys_lux", type number}, {"atmo_lys_LYS2__lys_medi", type number}, {"atmo_lys_atmotube_left__atmotube_pm1", type number}, {"atmo_lys_atmotube_left__atmotube_pm10", type number}, {"atmo_lys_atmotube_left__atmotube_pm2.5", type number}, {"atmo_lys_atmotube_right__atmotube_pm1", type number}, {"atmo_lys_atmotube_right__atmotube_pm10", type number}, {"atmo_lys_atmotube_right__atmotube_pm2.5", type number}, {"dominant_frequency_Hz", type number}, {"empatica__eda_scl_usiemens", type number}, {"empatica_eda_phasic", type number}, {"empatica_eda_tonic", type number}, {"empatica_heart_rate", type number}, {"empatica_hrv_fd_hf", type number}, {"empatica_hrv_fd_hfnu", type number}, {"empatica_hrv_fd_lf", type number}, {"empatica_hrv_fd_lf_hf_ratio", type number}, {"empatica_hrv_fd_lfnu", type number}, {"empatica_hrv_fd_total_power", type number}, {"empatica_hrv_fd_vlf", type number}, {"empatica_hrv_td_rmssd", type number}, {"empatica_hrv_td_sdnn", type number}, {"empatica_skin_temperature", type number}, {"empatica_vector_magnitude", type number}, {"eyetracker_blink_duration_s", type number}, {"eyetracker_distance_from_center", type number}, {"eyetracker_eyelid_aperture_avg", type number}, {"eyetracker_fixation_duration_s", type number}, {"eyetracker_fixation_rate", type number}, {"eyetracker_gaze_centrality", type number}, {"eyetracker_gaze_dispersion", type number}, {"eyetracker_gaze_velocity", type number}, {"eyetracker_pupil_change_rate", type number}, {"eyetracker_pupil_diameter_avg", type number}, {"eyetracker_saccade_amplitude", type number}, {"eyetracker_saccade_duration_s", type number}, {"eyetracker_saccade_peak_velocity", type number}, {"eyetracker_stress_composite", type number}, {"freq_proportion_2000_to_20000Hz", type number}, {"freq_proportion_200_to_2000Hz", type number}, {"freq_proportion_20_to_200Hz", type number}, {"gvi_50m", type number}, {"gvi_grass_50m", type number}, {"gvi_plant_50m", type number}, {"gvi_tree_50m", type number}, {"mechanisms_proportion", type number}, {"octave_proportion_1000_0_Hz", type number}, {"octave_proportion_125_0_Hz", type number}, {"octave_proportion_2000_0_Hz", type number}, {"octave_proportion_250_0_Hz", type number}, {"octave_proportion_31_5_Hz", type number}, {"octave_proportion_4000_0_Hz", type number}, {"octave_proportion_500_0_Hz", type number}, {"octave_proportion_63_0_Hz", type number}, {"octave_proportion_8000_0_Hz", type number}, {"questionnaire_current_comfort_1_7", type number}, {"questionnaire_environmental_comfort_mean_1_5", type number}, {"questionnaire_pleasantness_1_5", type number}, {"questionnaire_prs11_being_away_mean_1_5", type number}, {"questionnaire_prs11_coherence_mean_1_5", type number}, {"questionnaire_prs11_fascination_mean_1_5", type number}, {"questionnaire_prs11_scope_mean_1_5", type number}, {"questionnaire_prs11_total_mean_1_5", type number}, {"questionnaire_stai6_mean_1_5", type number}, {"questionnaire_thermal_comfort_1_5", type number}, {"rural_natural_proportion", type number}, {"spectral_centroid_Hz", type number}, {"spectral_rolloff85_Hz", type number}, {"ucm_AIR_RH", type number}, {"ucm_AIR_temp", type number}, {"ucm_GPS_speed_kmh", type number}, {"ucm_HUMIDEX", type number}, {"ucm_MRT", type number}, {"ucm_PET", type number}, {"ucm_SND_dBA", type number}, {"ucm_SUN_Gh", type number}, {"ucm_UTCI", type number}, {"ucm_WIND_AWS", type number}, {"unidentify_proportion", type number}, {"urban_manmade_negative_proportion", type number}, {"urban_manmade_neutral_proportion", type number}, {"urban_manmade_positive_proportion", type number}, {"vehicle_proportion", type number}, {"wind_proportion", type number}}, "en-US"),
		    Starts = Table.Group(Typed, {"ParticipantID", "PhaseID"}, {{"PhaseStart", each List.Min([Datetime]), type datetime}}),
		    StartsR = Table.RenameColumns(Starts, {{"ParticipantID", "sP"}, {"PhaseID", "sPh"}}),
		    Joined = Table.Join(Typed, {"ParticipantID", "PhaseID"}, StartsR, {"sP", "sPh"}, JoinKind.LeftOuter),
		    // Slot = 10 s step since the participant's first row in the phase (elapsed minutes = Slot / 6)
		    AddSlot = Table.AddColumn(Joined, "Slot", each Number.Round(Duration.TotalSeconds([Datetime] - [PhaseStart]) / 10, 0), Int64.Type),
		    // keep elapsed 0 to MaxElapsedMin (default 8 min); only Indoor of P8 and P17 run longer
		    InWindow = Table.SelectRows(AddSlot, each [Slot] < MaxElapsedMin * 6),
		    Mean2 = (a, b) => if a = null then b else if b = null then a else (a + b) / 2,
		    Add_atmo_pm1_avg = Table.AddColumn(InWindow, "atmo_pm1_avg", each Mean2(Record.Field(_, "atmo_lys_atmotube_left__atmotube_pm1"), Record.Field(_, "atmo_lys_atmotube_right__atmotube_pm1")), type number),
		    Add_atmo_pm25_avg = Table.AddColumn(Add_atmo_pm1_avg, "atmo_pm25_avg", each Mean2(Record.Field(_, "atmo_lys_atmotube_left__atmotube_pm2.5"), Record.Field(_, "atmo_lys_atmotube_right__atmotube_pm2.5")), type number),
		    Add_atmo_pm10_avg = Table.AddColumn(Add_atmo_pm25_avg, "atmo_pm10_avg", each Mean2(Record.Field(_, "atmo_lys_atmotube_left__atmotube_pm10"), Record.Field(_, "atmo_lys_atmotube_right__atmotube_pm10")), type number),
		    Result = Table.RemoveColumns(Add_atmo_pm10_avg, {"Datetime", "PhaseStart", "sP", "sPh"})
		in
		    Result
	lineageTag: 80e54ad8-d822-5db0-b535-39e9c7aac15a

	annotation PBI_ResultType = Table

