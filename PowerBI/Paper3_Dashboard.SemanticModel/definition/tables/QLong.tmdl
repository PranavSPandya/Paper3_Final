				    Src = Table.SelectColumns(Base, {"ParticipantID", "PhaseID", "Slot", "questionnaire_current_comfort_1_7", "questionnaire_thermal_comfort_1_5", "questionnaire_pleasantness_1_5", "questionnaire_environmental_comfort_mean_1_5", "questionnaire_stai6_mean_1_5", "questionnaire_prs11_total_mean_1_5", "questionnaire_prs11_fascination_mean_1_5", "questionnaire_prs11_being_away_mean_1_5", "questionnaire_prs11_coherence_mean_1_5", "questionnaire_prs11_scope_mean_1_5"}),
