/// Environment parameter list (Group -> Parameter); both slicers sit on this table, so Group filters the Parameter list
table EnvParam
	lineageTag: 1ccf3d47-7e03-593d-94fd-0ac07615a34a

	measure 'Env value' = AVERAGE(EnvLong[Value])
		formatString: 0.00
		lineageTag: 5cc9f6ea-4d34-57ad-b710-90557a30d0a3

	measure 'Env title' = VAR p = SELECTEDVALUE(EnvParam[Parameter]) RETURN IF(ISBLANK(p), "ENVIRONMENT: pick one parameter of the selected group", "ENVIRONMENT: " & p & ", mean over selected participants")
		lineageTag: d68d0255-4426-5e83-9e96-0dc642c8cb9d

	column ParamKey
		dataType: string
		isHidden
		lineageTag: 8bb23a60-449a-5051-947c-5874faeaf536
		summarizeBy: none
		sourceColumn: ParamKey

		annotation SummarizationSetBy = User

	column Group
		dataType: string
		lineageTag: 95c09e4c-5961-58b9-b027-ac5b5c98c58d
		summarizeBy: none
		sourceColumn: Group
		sortByColumn: GroupSort

		annotation SummarizationSetBy = User

	column GroupSort
		dataType: int64
		isHidden
		lineageTag: d60c19f9-a42c-5238-9d2e-6b55346ad81d
		summarizeBy: none
		sourceColumn: GroupSort

		annotation SummarizationSetBy = User

	column Parameter
		dataType: string
		lineageTag: c136d3b5-a3c4-5977-9788-798151617848
		summarizeBy: none
		sourceColumn: Parameter
		sortByColumn: ParamSort

		annotation SummarizationSetBy = User

	column ParamSort
		dataType: int64
		isHidden
		lineageTag: 3bd76fbc-f948-5ea1-89a8-3d25c1ca52c0
		summarizeBy: none
		sourceColumn: ParamSort

		annotation SummarizationSetBy = User

	partition EnvParam = m
		mode: import
		source =
				let
				    Source = #table(
				        type table [#"ParamKey" = text, #"Group" = text, #"GroupSort" = Int64.Type, #"Parameter" = text, #"ParamSort" = Int64.Type],
